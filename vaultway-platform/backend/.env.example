# ---------------------------------------------------------------------------
# Vaultway backend environment. Copy this file to `.env` and fill every value.
# NEVER commit the real .env file.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=4000

# Origin allowed by CORS (your Next.js app in dev)
CLIENT_ORIGIN=http://localhost:3000
# Optional extra origins, comma-separated (localhost / Vercel preview URLs are also allowed)
CORS_ORIGIN="http://localhost:3000,http://localhost:3001"

# --- Supabase PostgreSQL ----------------------------------------------------
# Project Settings -> Database -> Connect.
# DATABASE_URL uses the pooled (Transaction, port 6543) connection for the app.
# DIRECT_URL uses the direct (Session, port 5432) connection, required by Prisma Migrate.
DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# --- Supabase Storage -------------------------------------------------------
# Project Settings -> API. The service_role key is SECRET and server-only.
SUPABASE_URL="https://<ref>.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="<service-role-key>"
SUPABASE_STORAGE_BUCKET="vault-files"

# --- JWT --------------------------------------------------------------------
# Generate each with:  openssl rand -hex 32
JWT_ACCESS_SECRET="replace-with-32-byte-random-hex"
JWT_REFRESH_SECRET="replace-with-a-different-32-byte-random-hex"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# --- File encryption (AES-256-GCM) -----------------------------------------
# 32-byte key, base64-encoded. Generate with:  openssl rand -base64 32
# Losing this key makes every stored file unrecoverable — back it up securely.
FILE_ENCRYPTION_KEY="replace-with-base64-encoded-32-byte-key"

# --- Uploads ----------------------------------------------------------------
# Max upload size in bytes (default 5 GB).
MAX_FILE_SIZE_BYTES=5368709120

# --- Optional: seed an initial admin (used by prisma/seed.ts) ---------------
# Leave blank to seed roles only.
ADMIN_EMAIL=
ADMIN_USERNAME=
ADMIN_PASSWORD=
